# ============================================================
#  Vyapar Setu — Environment Configuration Template
#  Copy this file to .env and fill in real values
# ============================================================

# ── Application ──────────────────────────────────────────
APP_NAME="Vyapar Setu API"
APP_ENV=development            # development | production
APP_VERSION=1.0.0
DEBUG=true

# ── Database ─────────────────────────────────────────────
# Default: SQLite (no setup required)
DATABASE_URL=sqlite:///./vyapar_setu.db

# PostgreSQL (uncomment if using Postgres):
# DATABASE_URL=postgresql://user:password@localhost:5432/vyapar_setu

# ── Sarvam AI ─────────────────────────────────────────────
# Get your API key at: https://console.sarvam.ai
# Leave blank to use mock/demo mode
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai

# ── ML / Forecasting ─────────────────────────────────────
# Path where trained model .pkl files are stored
MODELS_DIR=./models
DATA_DIR=./data

# Forecast configuration
FORECAST_HORIZON_WEEKS=12
UNCERTAINTY_WINDOW_DAYS=90

# ── CORS ─────────────────────────────────────────────────
# Frontend origin (adjust port if needed)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://127.0.0.1:5500,null

# ── Rate Limits ──────────────────────────────────────────
MAX_RETRAIN_REQUESTS_PER_HOUR=5

# ── Audit / Logging ──────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=./logs/vyapar_setu.log
